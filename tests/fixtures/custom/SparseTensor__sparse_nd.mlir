#map = affine_map<(d0, d1, d2, d3, d4, d5, d6, d7) -> (d0, d1, d2, d3, d4, d5, d6, d7)>
#map1 = affine_map<(d0, d1, d2, d3, d4, d5, d6, d7) -> (d7, d6, d5, d4, d3, d2, d1, d0)>
#sparse = #sparse_tensor.encoding<{ map = (d0, d1, d2, d3, d4, d5, d6, d7) -> (d0 : dense, d1 : dense, d2 : dense, d3 : compressed, d4 : compressed, d5 : dense, d6 : dense, d7 : dense) }>
module {
  func.func @mul(%arg0: tensor<10x20x30x40x50x60x70x80xf32>, %arg1: tensor<80x70x60x50x40x30x20x10xf32, #sparse>, %arg2: tensor<10x20x30x40x50x60x70x80xf32>) -> tensor<10x20x30x40x50x60x70x80xf32> {
    %0 = linalg.generic {doc = "X(i,j,k,l,m,n,o,p) = A(i,j,k,l,m,n,o,p) * B(p,o,n,m,l,k,j,i)", indexing_maps = [#map, #map1, #map], iterator_types = ["parallel", "parallel", "parallel", "parallel", "parallel", "parallel", "parallel", "parallel"]} ins(%arg0, %arg1 : tensor<10x20x30x40x50x60x70x80xf32>, tensor<80x70x60x50x40x30x20x10xf32, #sparse>) outs(%arg2 : tensor<10x20x30x40x50x60x70x80xf32>) {
    ^bb0(%in: f32, %in_0: f32, %out: f32):
      %1 = arith.mulf %in, %in_0 : f32
      linalg.yield %1 : f32
    } -> tensor<10x20x30x40x50x60x70x80xf32>
    return %0 : tensor<10x20x30x40x50x60x70x80xf32>
  }
}

